# Frontend
# API endpoint the frontend calls. Keep it EMPTY so relative paths are used and the Vite dev server
# proxies /api, /threads and /health to the Agent API (single origin, no CORS setup needed).
VITE_API_BASE_URL=
# Absolute URL for /threads/*. If left empty, uses a relative path (via the Vite proxy).
VITE_THREADS_BASE_URL=
AGENT_PORT=8000

# Listen port for the Vite dev server (`make dev` / `make dev-front`). Default 5173.
FRONTEND_PORT=5173
# Hostnames to allow so Vite's Host check passes when the dev server is reached under a name other
# than localhost (comma-separated). Leave empty when browsing on the host itself.
# Example: FRONTEND_ALLOWED_HOSTS=redagent.lab.example,10.0.0.10
FRONTEND_ALLOWED_HOSTS=
# Port the browser connects to for HMR (WebSocket) when the dev server sits behind a reverse proxy
# that terminates on a different port. If left empty, HMR uses the same port as server.port.
FRONTEND_HMR_CLIENT_PORT=

# Agent API (FastAPI)

# Run mode. Default prod. `make dev` automatically sets APP_ENV=dev (no manual setup needed).
# In dev, if SESSION_COOKIE_SECURE is unset it automatically becomes non-Secure (login works over http://localhost).
# For production, leave it unset (= prod).
# APP_ENV=prod

# ===== Authentication (multi-user, session cookie) =====
# Signing key for the session cookie (signed token). Use a long random value.
# If empty, authentication is disabled. Leaving it empty is fine for a local `make dev`
# trial (every endpoint is then open without login); always set it on a shared host.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Users are managed in the DB (users table). Because no one can log in with zero users,
# create at least one via CLI when you set this:
#   python tools/auth/manage_users.py create <username>
# Note: rotating it invalidates all existing session cookies, requiring every user to log in again.
SESSION_SIGNING_SECRET=
# Session lifetime (seconds). Default 28800 (8 hours).
SESSION_TTL_SECONDS=28800
# Cookie Secure attribute. If unset, derived from APP_ENV (dev=false / prod=true).
# Setting it explicitly takes precedence. Normally leave unset and let APP_ENV decide.
# SESSION_COOKIE_SECURE=true
# Cookie name (optional). Default ra_session.
# SESSION_COOKIE_NAME=ra_session
# ===== MFA (TOTP, optional enrollment) =====
# At-rest encryption key (Fernet key) for the TOTP secret. MFA enrollment is possible only when this is set.
# If unset, MFA is disabled (already-enrolled secrets become undecryptable, so losing the key requires mfa-reset).
#   Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Note: a server-local secret. Rotating it makes existing enrolled secrets undecryptable (requires mfa-reset).
MFA_SECRET_KEY=
# Lifetime (seconds) of the MFA challenge token (login step 1 -> step 2). Default 300 (5 minutes).
# MFA_CHALLENGE_TTL_SECONDS=300
# Retention days for the audit log (audit_log). An in-app task periodically deletes rows older than this. Default 180.
AUDIT_LOG_RETENTION_DAYS=180
# Interval (hours) for the periodic audit-log pruning. Default 24 (once per day; also runs once right after startup).
AUDIT_LOG_PRUNE_INTERVAL_HOURS=24
# Temporary throttling of login failures (auto-clearing, not a permanent lock).
# A user with THRESHOLD or more failures within the recent window is rejected with 429 without verifying credentials,
# and is auto-cleared once WINDOW seconds have passed since the last failure. Evaluated by aggregating login_failed in audit_log.
# THRESHOLD default 5 / WINDOW default 900 seconds (15 minutes).
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1
# Regex to allow any localhost/127.0.0.1 port for development.
# If you open the frontend on a LAN IP, add http://<IP>:<port> to CORS_ORIGINS.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$
# Enable Swagger UI / OpenAPI schema (http://localhost:8000/docs). Handy while working with `make dev`.
ENABLE_DOCS=true
# Server-side gate for the command-approval (HITL) feature. Default true for this workspace.
# When true, the server accepts /api/v1/commands/execute and honors require_approval so the
# HITL review dialog is shown. On review, "edit" is CONSTRAINED: the command runs without a
# shell (shell=False) and an edit may change only the ARGUMENTS -- the tool/binary is locked
# to the LLM's choice (a changed binary is rejected 403), so edit is not an arbitrary-command
# execution vector. Keep in sync with the frontend's VITE_ENABLE_COMMAND_APPROVAL.
ENABLE_COMMAND_APPROVAL=true
# Lifetime (seconds) of _THREAD_SECRETS (temporary password storage). Default 3600 (1h).
THREAD_SECRET_TTL_SECONDS=3600
# Heartbeat interval (seconds) for SSE (:ping comments).
# Keep it well below the idle timeout of anything sitting in front of the API. 15s is a safe default.
SSE_PING_INTERVAL_SECONDS=15
# ===== SOCKS proxy =====
# The SOCKS5 proxy carrying traffic to the target range. It is provisioned separately (not part of
# this repository) and any implementation works -- the agent only consumes it via proxychains.
SOCKS_HOST=127.0.0.1
SOCKS_PORT=1080
# Port that remote SOCKS clients dial INTO (the reverse-tunnel control/listen port). When set,
# the status shown in the UI means "an ESTABLISHED connection exists on this port", i.e. a client
# is actually attached -- the signal that traffic can reach the target range.
# Leave empty to fall back to a plain TCP connect against SOCKS_PORT, which only proves the proxy
# is listening and cannot tell whether a client is attached.
# Do NOT point this at SOCKS_PORT: that is the local proxychains hop, so it is empty while idle
# and would also count the health check's own connection.
SOCKS_CHECK_PORT=

# LLM server
LLM_BASE_URL=http://127.0.0.1:18080/v1
LLM_MODEL=gemma-4-26b-a4b-it
#LLM_MODEL=mlx-community/qwen3.6-35b-a3b
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=3600

# Findings
FINDINGS_FILE=./data/findings.json

# Retest history DB (SQLite)
# Persistence target. Default is ./data/retest_history.db
DATABASE_URL=sqlite+aiosqlite:///./data/retest_history.db
# Max stored bytes for final_output_json (raw size before gzip).
# When exceeded, head and tail are kept and the middle is replaced with `... truncated N bytes ...`.
# 0 for unlimited. Default 1 MB.
RETEST_FINAL_OUTPUT_MAX_BYTES=1048576

# Kali MCP
# If unset, uses the Python running the agent (sys.executable), i.e. venv's python under `make dev`.
# Specify a full path only if you want to be explicit:
#   KALI_MCP_COMMAND=./venv/bin/python3
# Caution: writing just `python3` selects the system python, which cannot see venv's fastmcp etc. and fails to start,
# so always use a full path when overriding.
# KALI_MCP_COMMAND=
KALI_MCP_SCRIPT=./kali-mcp/server.py
# Master switch for proxychains prefixing. If false, nothing is prefixed regardless of use_proxychains (for testing).
# Whether each command is prefixed is controlled, on the verification path, by the proxychains flag in the command catalog JSON (-> the MCP use_proxychains argument).
KALI_PROXY_ENABLED=true
# The prefix command string. Override to change proxychains binary name differences (proxychains4 / proxychains-ng etc.) or flags.
KALI_PROXY_COMMAND=proxychains -q

# ===== Entra ID collection (roadrecon / forward-only operation) =====
# The roadrecon executable name (absolute path if not on PATH).
# Caution: point to the actual executable that roadtools installs into the venv.
# venv/bin/roadrecon is a "file", so do not append /roadrecon to the end
# (doing so fails auth with [Errno 20] Not a directory).
ROADRECON_BIN=./venv/bin/roadrecon
# Type of the injected token. Match the output of BAADTokenBroker etc. (prt-cookie / refresh-token / access-token).
ROADRECON_TOKEN_TYPE=prt-cookie
# Token-ingestion flag for roadrecon auth. Override only if the flag name differs in your roadrecon version
# (check with `roadrecon auth -h`).
# ROADRECON_AUTH_FLAG_PRT_COOKIE=--prt-cookie
# ROADRECON_AUTH_FLAG_REFRESH=--refresh-token
# ROADRECON_AUTH_FLAG_ACCESS=--access-token
# Output directory for the collected SQLite (roadrecon.db) (files split per tenant).
ENTRA_DB_DIR=./data/entra
# Whether to perform Entra collection via proxychains (true for SOCKS-based collection through a compliant device).
ENTRA_RECON_PROXYCHAINS=true
# Timeout (seconds) for roadrecon auth/gather (parent-process side). gather on huge tenants can take
# several to over ten minutes, so raise it to 1800-3600 for large targets. Also raise the
# roadrecon_collect.py child-process side ROADRECON_TIMEOUT (default 600) by a similar amount.
# Collection runs asynchronously as a background job, so even a large value returns the HTTP response
# immediately (the frontend polls the job status).
ENTRA_RECON_TIMEOUT=900
# Per-subcommand (auth/gather) timeout (seconds) for each roadrecon (child-process side).
# ROADRECON_TIMEOUT=600
# Seconds to keep collection-job state (done/failed) in memory. After it expires, polling returns 404, and
# the frontend falls back to checking /api/v1/entra/databases for whether collection completed.
# ENTRA_GATHER_JOB_TTL_SECONDS=1800

# Gate Retest / RTO execution on SOCKS liveness. Enabled by default; shipped as false here so a
# local `make dev` trial works before any SOCKS proxy exists. Set it to true (or remove the line)
# once the proxy is in place, so runs are blocked instead of failing against an unreachable target.
VITE_ENABLE_SOCKS_CHECK=false

# Feature flags (select which features are enabled at build time)
# All enabled if unset. Only those set to "false" / "0" / "off" are disabled.
# A disabled feature is excluded from nav, home cards, and routing.
VITE_ENABLE_RETEST=true
VITE_ENABLE_RTO=true
# UI for the command-approval (HITL) feature. Default true for this workspace. When on, it shows
# the retest approval checkbox / review dialog. Actual control is the server-side ENABLE_COMMAND_APPROVAL.
# Always keep both set to the same value (setting only the frontend to true still gets forced-false by the server).
VITE_ENABLE_COMMAND_APPROVAL=true
