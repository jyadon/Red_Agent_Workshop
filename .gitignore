data/auth_password.hash
data/*.hash
data/*.hash.tmp
# SQLite history DB (persisted re-test results)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Local staging area. Contains secrets/engagement data — MUST NOT be committed.
_stripped/
